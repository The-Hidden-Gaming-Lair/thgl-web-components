# games-web environment template — copy to .env.local and fill in as needed.
#
# YOU PROBABLY NEED NOTHING HERE. ~99% of the app (all Overwolf apps + every public
# game tenant like palia.localhost:3100) runs with ZERO secrets: the public API/CDN
# URLs default to production (api.th.gl, cdn.th.gl, api-forge.th.gl, actors-api.th.gl),
# so live data flows without any config.
#
# Secrets below are only for the www.th.gl (thgl-web) and app.th.gl (thgl-app)
# surfaces — Patreon login, the signed auth cookie, the status page, and the Palia
# authed routes. Ask Leon for real values only if you work on those. NEVER commit a
# filled-in .env.local (it's gitignored).

# ── Palia authed routes (leaderboard, rummage pile, cache purge) ───────────────
PALIA_API_KEY=              # auth to palia-api.th.gl (keyless GETs work without it)
PALIA_REVALIDATE_SECRET=    # verifies the palia cache-purge webhook

# ── thgl-app / thgl-web login + perks (Patreon OAuth) ─────────────────────────
PATREON_CLIENT_ID=          # Patreon OAuth app id
PATREON_CLIENT_SECRET=      # Patreon OAuth secret
PATREON_SPECIAL_USERS=      # comma-sep Patreon user ids granted special perks
JWT_SECRET=                 # signs/verifies the perks auth cookie (must match api-forge's JWT_SECRET)
# COOKIE_DOMAIN=.th.gl      # leave unset for localhost
NEXT_PUBLIC_BASE_URL=http://app.localhost:3100   # thgl-app OAuth redirect base (dev)

# ── Account / status storage ──────────────────────────────────────────────────
BUNNY_DATABASE_URL=                    # BunnyDB (libSQL) — account/perks + status page
BUNNY_DATABASE_AUTH_TOKEN=             # libSQL write token
BUNNY_DATABASE_READ_ONLY_AUTH_TOKEN=   # libSQL read-only token
BLOB_READ_WRITE_TOKEN=                 # Vercel Blob storage (avatars/uploads)
STATUS_RUN_SECRET=devsecret            # bearer gate for the status-run cron (any value locally)
# STATUS_DISCORD_WEBHOOK=              # posts status incidents to Discord

# ── Public config overrides (optional — default to production, no secret) ──────
# Only set these to point the app at a non-prod backend.
# NEXT_PUBLIC_TH_GL_URL=https://www.th.gl
# NEXT_PUBLIC_API_FORGE_URL=https://api-forge.th.gl
# NEXT_PUBLIC_DATA_FORGE_URL=https://api.th.gl
# NEXT_PUBLIC_DATA_FORGE_CDN_URL=https://cdn.th.gl
# NEXT_PUBLIC_FORGE_DEV_PROXY is set automatically by `next dev` — never set it manually.

# ── Deploy-only (CI/prod; you do NOT need these for local dev) ─────────────────
# BUNNY_ACCOUNT_API_KEY=    # Bunny edge purge on revalidate/status
# DISCORD_WEBHOOK_COMMENTS= # comment notifications

# ── Legacy / likely-unused (present in old .env.local, no current code refs) ───
# KV_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
